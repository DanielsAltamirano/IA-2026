# Entornos virtuales
.venv/
venv/
env/
ENV/

# Python cache y compilados
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/

# Archivos de IDE y editores
.vscode/
.idea/
*.swp
*.swo

# Archivos del Sistema Operativo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Archivos de logs y temporales
*.log
*.tmp

# Modelos XML pesados de visión artificial (superan límite de 100MB en GitHub)
modelo*.xml
*.xml
!**/data/*.xml

# Binarios ejecutables (manteniendo percep.exe según requerimiento)
*.exe
!**/percep.exe
